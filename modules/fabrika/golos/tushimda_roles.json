[[1, 0, "n", "[softly] ", "Tushimda Alloh bilan gaplashdim."], [1, 1, "n", "[calm] ", "Undan shunday so'radim:"], [1, 2, "q", "[sad, searching] ", "«Nega yomon narsalar yaxshi insonlarning boshiga keladi?»"], [2, 0, "n", "[reverent, softly] ", "Alloh qalbimga shunday ilhom qildi:"], [2, 1, "a", "[warmly, slowly] ", "«Eng kuchli daraxtlar ham kuchli shamollar bilan sinaladi."], [2, 2, "a", "[warmly, slowly] ", "Har qanday imtihon seni yanada sabrli va yanada kuchli qiladi»."], [3, 0, "n", "[calm] ", "Men yana so'radim:"], [3, 1, "q", "[sighs] [lonely, quiet] ", "«Nega bunchalar o'zimni yolg'iz his qilyapman?»"], [3, 2, "n", "[reverent, softly] ", "Alloh qalbimga dediki:"], [3, 3, "a", "[gently, slowly] ", "«Meni ko'rmaganliging yoningda emasman degani emas."], [3, 4, "a", "[warmly, reassuring] ", "Senga sen o'ylagandan ham yaqinroqman»."], [4, 0, "n", "[calm] ", "Men yana so'radim:"], [4, 1, "q", "[hopeful, unsure] ", "«Hammasi bir kun kelib yaxshi bo'ladimi?»"], [4, 2, "a", "[gently, slowly] ", "«Men taqdir qilgan vaqt seniki emas. Sabr qil."], [4, 3, "a", "[warmly, slowly] ", "Har bir qiyinchilik ortidan yengillik keladi."], [4, 4, "a", "[hopeful, warmly] ", "Shamollar tugaydi, quyosh yangidan chiqadi»."], [5, 0, "n", "[nervous, softly] ", "Men qo'rqib so'radim:"], [5, 1, "q", "[afraid, trembling] ", "«Bu yuklarni ko'tara olmasam-chi?»"], [5, 2, "n", "[reverent, softly] ", "Alloh qalbimga huzur berdi:"], [5, 3, "a", "[calm, strong, slowly] ", "«Alloh hech kimga kuchi yetmaydigan yuk bermaydi."], [5, 4, "a", "[warmly, slowly] ", "Sen zaif bo'lganingda kuch beradigan Menman»."], [6, 0, "f", "[sighs] [sad, softly] ", "Ko'z yosh bilan pichirladim:"], [6, 1, "f", "[whispering, tearful] ", "«Gunohlarim ko'p bo'lsa ham, meni sevasanmi?»"], [6, 2, "f", "[reverent, softly] ", "Alloh yana qalbimga huzur berdi:"], [6, 3, "f", "[warmly, gently, slowly] ", "«Men tavba qilgan bandalarimga cheksiz marhamatliman», dedi."]]