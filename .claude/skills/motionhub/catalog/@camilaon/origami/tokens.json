{
  "color": {
    "$type": "color",
    "table": {"$value": {"colorSpace": "srgb", "components": [0.9255, 0.9059, 0.8706], "hex": "#ECE7DE"}, "$description": "the table the paper lies on; the ground of every frame"},
    "front": {"$value": {"colorSpace": "srgb", "components": [0.1804, 0.3098, 0.549], "hex": "#2E4F8C"}, "$description": "the paper's coloured side"},
    "back": {"$value": {"colorSpace": "srgb", "components": [0.9569, 0.9412, 0.902], "hex": "#F4F0E6"}, "$description": "the paper's white side, and the faint marks of folded creases"},
    "ink": {"$value": {"colorSpace": "srgb", "components": [0.1137, 0.1412, 0.2], "hex": "#1D2433"}, "$description": "titles, the steps done, the sheet's outline"},
    "pencil": {"$value": {"colorSpace": "srgb", "components": [0.5412, 0.5412, 0.5255], "hex": "#8A8A86"}, "$description": "subtitles, steps to come, labels"},
    "now": {"$value": {"colorSpace": "srgb", "components": [0.8941, 0.3412, 0.1804], "hex": "#E4572E"}, "$description": "the accent: the fold about to be made and the step in hand, nothing else"}
  },
  "font": {
    "$type": "fontFamily",
    "sans": {"$value": ["IBM Plex Sans", "Noto Sans SC", "sans-serif"], "$description": "every word: titles, steps, labels, captions"}
  },
  "duration": {
    "$type": "duration",
    "mark": {"$value": {"value": 0.9, "unit": "s"}, "$description": "drawing the next fold line on before it is made"},
    "fold": {"$value": {"value": 1.8, "unit": "s"}, "$description": "one step's fold"},
    "hold": {"$value": {"value": 1.1, "unit": "s"}, "$description": "the least a folded step rests before the next is marked"}
  },
  "easing": {
    "$type": "cubicBezier",
    "camera": {"$value": [0.45, 0, 0.2, 1], "$description": "the camera's moves; folds carry their own ease from the solve"}
  },
  "caption": {
    "font": {"$type": "fontFamily", "$value": "{font.sans}"},
    "size": {"$type": "dimension", "$value": {"value": 34, "unit": "px"}},
    "color": {"$type": "color", "$value": "{color.ink}"},
    "background": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 0.9922, 0.9647], "hex": "#FFFDF6", "alpha": 0.97}},
    "radius": {"$type": "dimension", "$value": {"value": 3, "unit": "px"}},
    "padding-y": {"$type": "dimension", "$value": {"value": 10, "unit": "px"}},
    "padding-x": {"$type": "dimension", "$value": {"value": 26, "unit": "px"}},
    "bottom": {"$type": "dimension", "$value": {"value": 58, "unit": "px"}}
  }
}
