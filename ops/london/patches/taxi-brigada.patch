+
+# ---------- владелец ----------
+async def owner_panel(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    user, msg = update.effective_user, update.effective_message
+    if not is_admin(user.id if user else None):
+        return
+    rows = all_brigadiers()
+    lines = [f"🚖 <b>БРИГАДИРЛАР</b>: {len(rows)} та"]
+    btn = [[InlineKeyboardButton("➕ Янги бригадир", callback_data="bro:new")]]
+    for b in rows:
+        debt = owed(b["uid"])
+        lines.append(f"✅ {esc(b['name'])} · 👥 {b['n']} · қарз: {money(debt)}")
+        row = [InlineKeyboardButton(f"📤 {first_name(b['name'])[:14]} — QR", callback_data=f"bro:kit:{b['uid']}")]
+        if debt:
+            row.append(InlineKeyboardButton(f"💸 Тўладим {money(debt)}", callback_data=f"bro:paid:{b['uid']}"))
+        btn.append(row)
+    if not rows:
+        lines.append("Ҳали йўқ. «➕ Янги бригадир» — бир марталик таклиф.")
+    await msg.reply_text("\n".join(lines), parse_mode="HTML", reply_markup=InlineKeyboardMarkup(btn))
+
+
+async def owner_buttons(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    q = update.callback_query
+    if not is_admin(q.from_user.id):
+        await q.answer("Бу амал фақат админ учун.", show_alert=True)
+        return
+    await q.answer()
+    parts = q.data.split(":")
+    if parts[1] == "new":
+        link = f"https://t.me/{context.bot.username}?start=bi_{new_invite()}"
+        share = ("https://t.me/share/url?url=" + urllib.parse.quote(link, safe="")
+                 + "&text=" + urllib.parse.quote(INVITE_SHORT, safe=""))
+        await send_qr(context.bot, q.from_user.id, link, invite_text(link),
+                      InlineKeyboardMarkup([[InlineKeyboardButton("📤 Юбориш", url=share)]]))
+    elif parts[1] == "kit" and parts[2].isdigit():
+        await send_kit(context.bot, int(parts[2]))
+    elif parts[1] == "paid" and parts[2].isdigit():
+        total = mark_paid(int(parts[2]))
+        b = brigadier(int(parts[2]))
+        if total and b:
+            try:
+                await context.bot.send_message(b["uid"], f"💰 Сизга {money(total)} тўланди. Раҳмат!")
+            except Exception:
+                pass
+        await context.bot.send_message(q.from_user.id, f"✅ Ёпилди: {money(total)}")
+
+
+async def on_topup_approved(bot, driver_id: int, amount: int) -> None:
+    """drivers.review_topup'дан: жамоа аъзоси ойлик тўлади → бригадирга улуш."""
+    try:
+        res = record_share(int(driver_id), int(amount))
+    except Exception as exc:
+        logger.warning("brigada share: %s", exc)
+        return
+    if not res:
+        return
+    bid, share = res
+    b = brigadier(bid)
+    try:
+        await bot.send_message(bid, f"💰 Жамоангиздан ҳайдовчи ойлик тўлади — сизга <b>{money(share)}</b>.\n"
+                                    f"Жами қарз: {money(owed(bid))}", parse_mode="HTML")
+    except Exception:
+        pass
+    await notify_admins(bot, f"🚖 Бригадир {esc(first_name(b['name'] if b else ''))}: +{money(share)} улуш "
+                             f"(жами {money(owed(bid))}). Тўлаганда — «{BTN_BRIGADA}» → «💸 Тўладим».")
+
+
+def brigada_handlers() -> tuple:
+    """group=0 (main.build_application бошида)."""
+    return (
+        MessageHandler(filters.Regex("^" + re.escape(BTN_BRIGADA) + "$"), owner_panel),
+        CallbackQueryHandler(join_car, pattern=r"^brj:\d+:\w+$"),
+        CallbackQueryHandler(member_decide, pattern=r"^brm:(ok|no):\d+$"),
+        CallbackQueryHandler(brig_buttons, pattern=r"^brg:(team|add)$"),
+        CallbackQueryHandler(owner_buttons, pattern=r"^bro:(new|kit:\d+|paid:\d+)$"),
+    )
+
+
+def brigada_contact_handler() -> MessageHandler:
+    """Алоҳида гуруҳ (5): бошқа суҳбатлардаги контактларга халақит бермайди."""
+    return MessageHandler(filters.CONTACT, join_contact)
