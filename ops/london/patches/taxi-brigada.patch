+"""🚖 Бригадир + жамоа (02.11.2026, владелец: «схема прораба — и для такси»).
+
+Бригадир — фақат владелец таклифи (бир марталик ҳавола). Бригадирнинг ўз QR'и: ҳайдовчи → машина тури →
+«📱 Рақамни юбориш» → бригадир ✅. Жамоа аъзоси ойлик обунани (50 000) тўласа ва админ тасдиқласа —
+бригадирга улуш (BRIGADA_SHARE, 10 000 сўм) ҳисобланади, владелец «💸 Тўладим» билан ёпади.
+Владелец бригадирга юборилган ҳамма нарсанинг нусхасини кўради. Мавжуд такси оқими ўзгармайди.
+"""
+import html
+import re
+import logging
+import secrets
+import urllib.parse
+from contextlib import closing
+
+from telegram import (InlineKeyboardButton, InlineKeyboardMarkup, KeyboardButton, ReplyKeyboardMarkup, Update)
+from telegram.ext import CallbackQueryHandler, ContextTypes, MessageHandler, filters
+
+from bot.database import _connect, register_driver
+from bot.keyboards.reply import BTN_BRIGADA, main_menu_keyboard
+from config import config
+
+logger = logging.getLogger(__name__)
+BRIGADA_SHARE = 10_000          # жамоа аъзоси ойлик тўласа — бригадирга (сўм)
+CARS = {"car": "🚕 Енгил авто", "damas": "🚐 Дамас", "cargo": "🚚 Юк авто", "other": "⚙️ Бошқа"}
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS brigada (uid INTEGER PRIMARY KEY, name TEXT, username TEXT,
+    status TEXT NOT NULL DEFAULT 'ok', created_at TEXT DEFAULT CURRENT_TIMESTAMP);
+CREATE TABLE IF NOT EXISTS brigada_members (uid INTEGER PRIMARY KEY, brigadier INTEGER NOT NULL, name TEXT,
+    username TEXT, phone TEXT, car TEXT, status TEXT NOT NULL DEFAULT 'pending', created_at TEXT DEFAULT CURRENT_TIMESTAMP);
+CREATE TABLE IF NOT EXISTS brigada_invites (code TEXT PRIMARY KEY, used_by INTEGER, created_at TEXT DEFAULT CURRENT_TIMESTAMP);
+CREATE TABLE IF NOT EXISTS brigada_earnings (id INTEGER PRIMARY KEY AUTOINCREMENT, brigadier INTEGER NOT NULL,
+    driver INTEGER NOT NULL, amount INTEGER NOT NULL, share INTEGER NOT NULL, paid INTEGER NOT NULL DEFAULT 0,
+    created_at TEXT DEFAULT CURRENT_TIMESTAMP);
+"""
+
+
+# ---------- база ----------
+def db():
+    con = _connect()
+    con.executescript(SCHEMA)
+    return con
+
+
+def money(v: int) -> str:
+    return f"{int(v):,}".replace(",", " ") + " сўм"
+
+
+def esc(s) -> str:
+    return html.escape(str(s or ""), quote=False)
+
+
+def first_name(full: str | None) -> str:
+    return (full or "Бригадир").split()[0]
+
+
+def new_invite() -> str:
+    code = secrets.token_urlsafe(9).replace("-", "x").replace("_", "y")
+    with closing(db()) as con, con:
+        con.execute("INSERT INTO brigada_invites(code) VALUES (?)", (code,))
+    return code
+
+
+def use_invite(code: str, uid: int) -> bool:
+    """Бир марталик: биринчи кирган одамники; ўша одам қайта босса ҳам ишлайди."""
+    with closing(db()) as con, con:
+        row = con.execute("SELECT used_by FROM brigada_invites WHERE code=?", (code,)).fetchone()
+        if not row or (row[0] is not None and row[0] != uid):
+            return False
+        con.execute("UPDATE brigada_invites SET used_by=? WHERE code=?", (uid, code))
+        return True
+
+
+def add_brigadier(uid: int, name: str | None, username: str | None) -> None:
+    with closing(db()) as con, con:
+        con.execute("""INSERT INTO brigada(uid, name, username, status) VALUES (?,?,?,'ok')
+            ON CONFLICT(uid) DO UPDATE SET name=excluded.name, username=excluded.username, status='ok'""",
+                    (uid, name, username))
+
+
+def brigadier(uid: int):
+    with closing(db()) as con:
+        return con.execute("SELECT * FROM brigada WHERE uid=? AND status='ok'", (uid,)).fetchone()
+
+
+def add_member(uid: int, bid: int, name, username, phone: str, car: str):
+    with closing(db()) as con, con:
+        con.execute("""INSERT INTO brigada_members(uid, brigadier, name, username, phone, car, status)
+            VALUES (?,?,?,?,?,?,'pending') ON CONFLICT(uid) DO UPDATE SET brigadier=excluded.brigadier,
+            name=excluded.name, username=excluded.username, phone=excluded.phone, car=excluded.car, status='pending'""",
+                    (uid, bid, name, username, phone, car))
+        return con.execute("SELECT * FROM brigada_members WHERE uid=?", (uid,)).fetchone()
+
+
+def set_member(uid: int, bid: int, status: str):
+    with closing(db()) as con, con:
+        con.execute("UPDATE brigada_members SET status=? WHERE uid=? AND brigadier=?", (status, uid, bid))
+        return con.execute("SELECT * FROM brigada_members WHERE uid=? AND brigadier=?", (uid, bid)).fetchone()
+
+
+def team(bid: int) -> list:
+    with closing(db()) as con:
+        return list(con.execute("SELECT * FROM brigada_members WHERE brigadier=? AND status!='no' "
+                                "ORDER BY status DESC, created_at", (bid,)))
+
+
+def record_share(driver_id: int, amount: int):
+    """Ойлик тўлов тасдиқланди: ҳайдовчи жамоада бўлса — бригадирга улуш. (brigadier_uid, share) ёки None."""
+    with closing(db()) as con, con:
+        m = con.execute("SELECT brigadier FROM brigada_members WHERE uid=? AND status='ok'", (driver_id,)).fetchone()
+        if not m:
+            return None
+        con.execute("INSERT INTO brigada_earnings(brigadier, driver, amount, share) VALUES (?,?,?,?)",
+                    (m[0], driver_id, amount, BRIGADA_SHARE))
+        return int(m[0]), BRIGADA_SHARE
+
+
+def owed(bid: int) -> int:
+    with closing(db()) as con:
+        return int(con.execute("SELECT COALESCE(SUM(share),0) FROM brigada_earnings WHERE brigadier=? AND paid=0",
+                               (bid,)).fetchone()[0])
+
+
+def mark_paid(bid: int) -> int:
+    with closing(db()) as con, con:
+        total = int(con.execute("SELECT COALESCE(SUM(share),0) FROM brigada_earnings WHERE brigadier=? AND paid=0",
+                                (bid,)).fetchone()[0])
+        con.execute("UPDATE brigada_earnings SET paid=1 WHERE brigadier=? AND paid=0", (bid,))
+        return total
+
+
+def all_brigadiers() -> list:
+    with closing(db()) as con:
+        return list(con.execute("""SELECT b.*, (SELECT COUNT(*) FROM brigada_members m
+            WHERE m.brigadier=b.uid AND m.status='ok') AS n FROM brigada b WHERE b.status='ok' ORDER BY b.created_at"""))
+
+
+# ---------- матнлар (ўзбек кирилл) ----------
+def invite_text(link: str) -> str:
+    return ("🚖 <b>XOJAOBOD CITY 24 — БРИГАДИР ТАКЛИФИ</b>\n\n"
+            "Сиз <b>Бригадир</b> бўласиз:\n"
+            "👥 ўз ҳайдовчилар жамоангизни йиғасиз\n"
+            "✅ жамоангизга кимни олишни ўзингиз ҳал қиласиз\n"
+            f"💰 жамоангиздаги ҳар бир ҳайдовчи ойлик тўласа — сизга <b>{money(BRIGADA_SHARE)}</b>\n\n"
+            "<b>Қандай кираман?</b>\nҲаволани босинг — бўлди. Кейин бот сизга жамоангиз QR-кодини юборади.\n\n"
+            f"⚠️ Ҳавола фақат сиз учун — бир марта ишлайди.\n\n🔗 {link}")
+
+
+INVITE_SHORT = ("🚖 XOJAOBOD CITY 24 — бригадир таклифи. Ўз ҳайдовчилар жамоангизни йиғасиз, "
+                "ҳар бир ҳайдовчидан улуш оласиз. Ҳаволани босинг — бўлди. Ҳавола фақат сиз учун.")
+
+
+def kit_for_brigadier(name: str) -> str:
+    return (f"<b>Ассалому алайкум, {esc(name)}! 🚖</b>\n\n"
+            "Сиз — <b>XOJAOBOD CITY 24</b> такси хизматининг Бригадирисиз. Мана <b>жамоангиз QR-коди</b>.\n\n"
+            "<b>Ҳайдовчиларингиз қандай қўшилади:</b>\n1️⃣ QR-кодни сканер қилади\n2️⃣ Машина турини танлайди\n"
+            "3️⃣ «📱 Рақамни юбориш» — бўлди!\nКейин сизга хабар келади — <b>✅ Тасдиқлаш</b> ни босасиз.\n\n"
+            f"<b>Пул:</b> жамоангиздаги ҳайдовчи ойлик обуна тўласа — сизга <b>{money(BRIGADA_SHARE)}</b>.\n\n"
+            "Пастда — жамоангиз учун тайёр хабар. Уни ҳайдовчиларингизга <b>юборинг (переслать)</b> 👇")
+
+
+def kit_for_team(name: str, link: str) -> str:
+    return (f"<b>🚖 {esc(name).upper()} ЖАМОАСИГА ҚЎШИЛИНГ</b>\n\n"
+            "Бу — <b>XOJAOBOD CITY 24</b> боти. Хўжаобод бўйлаб такси буюртмалари шу ерга келади.\n\n"
+            "<b>Қандай қўшиламан?</b>\n1️⃣ QR-кодни сканер қилинг (ёки пастдаги ҳаволани босинг)\n"
+            "2️⃣ Машина турини танланг\n3️⃣ «📱 Рақамни юбориш» тугмасини босинг — бўлди!\n\n"
+            f"<b>Кейин нима бўлади?</b>\n✅ {esc(name)} тасдиқлайди — сиз жамоадасиз\n"
+            "💳 Ойлик обуна (50 000 сўм) тўлайсиз — буюртмалар келишни бошлайди\n"
+            "🔔 Буюртма келса — «Қабул қилиш» ни босасиз, биринчи олган ҳайдовчиники\n\n"
+            f"🔗 {link}")
+
+
+def qr_url(link: str) -> str:
+    return "https://api.qrserver.com/v1/create-qr-code/?size=600x600&margin=20&data=" + urllib.parse.quote(link, safe="")
+
+
+def team_link(bot_username: str, bid: int) -> str:
+    return f"https://t.me/{bot_username}?start=bt{bid}"
+
+
+def is_admin(uid: int | None) -> bool:
+    return bool(uid) and uid in config.ADMIN_IDS
+
+
+async def send_qr(bot, chat: int, link: str, caption: str, markup=None) -> None:
+    try:
+        await bot.send_photo(chat, qr_url(link), caption=caption, parse_mode="HTML", reply_markup=markup)
+    except Exception as exc:  # QR бўлмаса ҳам ҳавола етади
+        logger.warning("brigada qr: %s", exc)
+        await bot.send_message(chat, caption, parse_mode="HTML", reply_markup=markup, disable_web_page_preview=True)
+
+
+async def notify_admins(bot, text: str, markup=None) -> None:
+    for admin_id in config.ADMIN_IDS:
+        try:
+            await bot.send_message(admin_id, text, parse_mode="HTML", reply_markup=markup)
+        except Exception:
+            pass
+
+
+def brig_menu() -> InlineKeyboardMarkup:
+    return InlineKeyboardMarkup([[InlineKeyboardButton("👥 Жамоам", callback_data="brg:team"),
+                                  InlineKeyboardButton("➕ Жамоага қўшиш", callback_data="brg:add")]])
+
+
+async def send_kit(bot, bid: int, to_brigadier: bool = True) -> None:
+    """Бригадирга QR + 2 матн; владелец — айнан нусхаси."""
+    b = brigadier(bid)
+    if not b:
+        return
+    name = first_name(b["name"])
+    link = team_link(bot.username, bid)
+    msgs = [kit_for_brigadier(name), kit_for_team(name, link)]
+    if to_brigadier:
+        for i, cap in enumerate(msgs):
+            await send_qr(bot, bid, link, cap, brig_menu() if i == 0 else None)
+    await notify_admins(bot, f"👀 <b>{esc(name)}га юборилди</b> — у кўрган 2 та хабарнинг нусхаси 👇")
+    for admin_id in config.ADMIN_IDS:
+        for cap in msgs:
+            await send_qr(bot, admin_id, link, cap)
+
+
+# ---------- /start ҳаволалари ----------
+async def brigada_start(update: Update, context: ContextTypes.DEFAULT_TYPE, arg: str) -> bool:
+    """main.start'дан чақирилади. True — ҳавола бизники ва ишланди."""
+    user, msg = update.effective_user, update.effective_message
+    if not user or not msg:
+        return False
+    if arg.startswith("bi_"):                                  # бригадир таклифи
+        if not use_invite(arg[3:40], user.id):
+            await msg.reply_text("Бу таклиф ҳаволаси ишлатилган ёки нотўғри. Админдан янгисини сўранг.")
+            return True
+        register_driver(user.id, user.username, user.full_name)
+        add_brigadier(user.id, user.full_name, user.username)
+        await msg.reply_text("🎉 Сиз <b>Бригадир</b> сифатида рўйхатдасиз!", parse_mode="HTML")
+        await notify_admins(context.bot, f"🚖 Таклиф орқали янги бригадир: <b>{esc(user.full_name)}</b>"
+                                         f"{' @' + user.username if user.username else ''} · ID {user.id}")
+        await send_kit(context.bot, user.id)
+        return True
+    if arg.startswith("bt") and arg[2:].isdigit():             # бригадир жамоасига қўшилиш
+        b = brigadier(int(arg[2:]))
+        if not b:
+            await msg.reply_text("Ҳавола нотўғри. Бригадирингиздан янгисини сўранг.")
+            return True
+        context.user_data["brigada_join"] = {"bid": b["uid"]}
+        kb = InlineKeyboardMarkup([[InlineKeyboardButton(v, callback_data=f"brj:{b['uid']}:{k}")] for k, v in CARS.items()])
+        await msg.reply_text(f"🚖 <b>{esc(first_name(b['name'])).upper()} ЖАМОАСИГА ҚЎШИЛИШ</b>\n\nМашинангиз тури 👇",
+                             parse_mode="HTML", reply_markup=kb)
+        return True
+    return False
+
+
+async def join_car(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    q = update.callback_query
+    _, bid, car = q.data.split(":")
+    await q.answer()
+    if not brigadier(int(bid)) or car not in CARS:
+        return
+    context.user_data["brigada_join"] = {"bid": int(bid), "car": car}
+    kb = ReplyKeyboardMarkup([[KeyboardButton("📱 Рақамни юбориш", request_contact=True)]],
+                             resize_keyboard=True, one_time_keyboard=True)
+    await q.message.reply_text(f"{CARS[car]} ✅\n\n📱 Пастдаги «Рақамни юбориш» тугмасини босинг — бўлди.", reply_markup=kb)
+
+
+async def join_contact(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    """Алоҳида гуруҳда ишлайди: фақат жамоага қўшилаётган одамнинг контактини олади."""
+    data = context.user_data.get("brigada_join")
+    msg, user = update.effective_message, update.effective_user
+    if not data or "car" not in data or not msg or not msg.contact or not user:
+        return
+    if msg.contact.user_id and msg.contact.user_id != user.id:
+        await msg.reply_text("Ўзингизнинг рақамингизни «📱 Рақамни юбориш» тугмаси билан юборинг.")
+        return
+    context.user_data.pop("brigada_join", None)
+    phone = "+" + msg.contact.phone_number.lstrip("+")
+    m = add_member(user.id, data["bid"], user.full_name, user.username, phone, data["car"])
+    register_driver(user.id, user.username, user.full_name)
+    b = brigadier(data["bid"])
+    await msg.reply_text(f"✅ Тайёр! {esc(first_name(b['name']))} тасдиқлагач хабар берамиз.",
+                         reply_markup=main_menu_keyboard(is_admin(user.id)))
+    card = member_card(m, b)
+    kb = InlineKeyboardMarkup([[InlineKeyboardButton("✅ Тасдиқлаш", callback_data=f"brm:ok:{user.id}"),
+                                InlineKeyboardButton("❌ Рад этиш", callback_data=f"brm:no:{user.id}")]])
+    try:
+        await context.bot.send_message(b["uid"], "👥 Жамоангизга янги ҳайдовчи: тасдиқлайсизми?\n\n" + card,
+                                       parse_mode="HTML", reply_markup=kb)
+    except Exception as exc:
+        logger.warning("brigada notify: %s", exc)
+    await notify_admins(context.bot, f"ℹ️ {esc(first_name(b['name']))} жамоасига янги ҳайдовчи (бригадир тасдиқлайди)\n\n" + card)
+
+
+def member_card(m, b=None) -> str:
+    st = {"pending": "⏳ кутмоқда", "ok": "✅ жамоада", "no": "❌ рад"}.get(m["status"], m["status"])
+    un = f" @{m['username']}" if m["username"] else ""
+    tm = f"\n🚖 бригадир: {esc(first_name(b['name']))}" if b else ""
+    return (f"🚗 <b>{esc(m['name'])}</b>{un}\n🆔 {m['uid']}\n📞 {esc(m['phone'])}\n{CARS.get(m['car'], m['car'])}{tm}\n{st}")
+
+
+async def member_decide(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    q = update.callback_query
+    _, act, raw = q.data.split(":")
+    b = brigadier(q.from_user.id)
+    if not b:
+        await q.answer("Бу тугма фақат бригадир учун.", show_alert=True)
+        return
+    m = set_member(int(raw), b["uid"], "ok" if act == "ok" else "no")
+    if not m:
+        await q.answer("Бу ҳайдовчи сизнинг жамоангизда эмас.", show_alert=True)
+        return
+    await q.answer("✅" if act == "ok" else "❌")
+    try:
+        await q.edit_message_text(member_card(m, b), parse_mode="HTML")
+    except Exception:
+        pass
+    if act == "ok":
+        pay = InlineKeyboardMarkup([[InlineKeyboardButton("💳 Ойлик тўлов (50 000)", callback_data="auto:driver:pay")]])
+        await context.bot.send_message(m["uid"], f"🎉 Сиз {esc(first_name(b['name']))} жамоасидасиз!\n\n"
+                                                 "Буюртмалар келиши учун ойлик обунани тўланг 👇",
+                                       parse_mode="HTML", reply_markup=pay)
+    else:
+        await context.bot.send_message(m["uid"], "Афсуски, бригадир ҳозирча тасдиқламади.")
+    await notify_admins(context.bot, f"🚖 {esc(first_name(b['name']))}: {esc(m['name'])} — "
+                                     f"{'✅ жамоага қўшилди' if act == 'ok' else '❌ рад'}")
+
+
+# ---------- бригадир тугмалари ----------
+async def brig_buttons(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
