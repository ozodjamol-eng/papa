diff -ruN pristine/tests/test_brigada.py newv/tests/test_brigada.py
--- pristine/tests/test_brigada.py	1970-01-01 06:00:00.000000000 +0600
+++ newv/tests/test_brigada.py	2026-11-02 23:37:15.783442979 +0500
@@ -0,0 +1,136 @@
+"""02.11: бригадир + жамоа — таклиф бир марталик, жамоа QR, бригадир тасдиқлайди, ойликдан улуш, владелец нусха кўради."""
+import os
+import tempfile
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from bot import database
+from bot.handlers import brigada as B
+from config import config
+
+OWNER = 5000
+
+
+class FakeBot:
+    username = "xojaobodcity24bot"
+
+    def __init__(self):
+        self.sent = []
+
+    async def send_message(self, chat, text, **kw):
+        self.sent.append(("msg", chat, text, kw))
+
+    async def send_photo(self, chat, photo, caption=None, **kw):
+        self.sent.append(("photo", chat, caption, kw))
+
+    def to(self, chat):
+        return [s for s in self.sent if s[1] == chat]
+
+
+class Msg:
+    def __init__(self, bot, chat, contact=None):
+        self.bot, self.chat, self.contact = bot, chat, contact
+        self.replies = []
+
+    async def reply_text(self, text, **kw):
+        self.replies.append(text)
+        self.bot.sent.append(("msg", self.chat, text, kw))
+
+
+def user(uid, name="Али Валиев", username="ali"):
+    return SimpleNamespace(id=uid, full_name=name, username=username)
+
+
+def upd(bot, uid, name="Али Валиев", contact=None, data=None):
+    u = user(uid, name)
+    m = Msg(bot, uid, contact)
+    q = None
+    if data:
+        async def answer(*a, **k):
+            return None
+
+        async def edit(*a, **k):
+            return None
+        q = SimpleNamespace(data=data, from_user=u, answer=answer, edit_message_text=edit, message=m)
+    return SimpleNamespace(effective_user=u, effective_message=m, callback_query=q)
+
+
+class BrigadaTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.p = [patch.object(config, "DATABASE_PATH", os.path.join(self.temp.name, "b.sqlite3")),
+                  patch.object(config, "ADMIN_IDS", [OWNER])]
+        for p in self.p:
+            p.start()
+        database.init_db()
+        self.bot = FakeBot()
+
+    def tearDown(self):
+        for p in self.p:
+            p.stop()
+        self.temp.cleanup()
+
+    def ctx(self, ud=None):
+        return SimpleNamespace(bot=self.bot, user_data=ud if ud is not None else {})
+
+    async def invite_brigadier(self, uid=77):
+        await B.owner_buttons(upd(self.bot, OWNER, data="bro:new"), self.ctx())
+        cap = [s for s in self.bot.sent if s[0] == "photo" and s[1] == OWNER][-1][2]
+        self.assertIn("БРИГАДИР ТАКЛИФИ", cap)
+        code = cap.split("start=bi_")[1].split()[0]
+        self.assertTrue(await B.brigada_start(upd(self.bot, uid, "Бекзод Алиев"), self.ctx(), f"bi_{code}"))
+        return code
+
+    async def test_invite_once_and_kit_with_owner_copy(self):
+        code = await self.invite_brigadier(77)
+        self.assertIsNotNone(B.brigadier(77))
+        self.assertIsNotNone(database.driver_info(77))                       # бригадир ҳам ҳайдовчи
+        caps = [s[2] for s in self.bot.to(77) if s[0] == "photo"]
+        self.assertTrue(any("Бригадирисиз" in c for c in caps) and any("ЖАМОАСИГА ҚЎШИЛИНГ" in c for c in caps))
+        self.assertTrue(any(s[0] == "photo" and "ЖАМОАСИГА" in (s[2] or "") for s in self.bot.to(OWNER)))  # нусха
+        await B.brigada_start(upd(self.bot, 88), self.ctx(), f"bi_{code}")     # бошқа одам — йўқ
+        self.assertIsNone(B.brigadier(88))
+
+    async def test_team_join_approve_and_share(self):
+        await self.invite_brigadier(77)
+        ud = {}
+        self.assertTrue(await B.brigada_start(upd(self.bot, 90, "Карим Ҳайдовчи"), self.ctx(ud), "bt77"))
+        await B.join_car(upd(self.bot, 90, data="brj:77:damas"), self.ctx(ud))
+        contact = SimpleNamespace(user_id=90, phone_number="998901112233")
+        await B.join_contact(upd(self.bot, 90, "Карим Ҳайдовчи", contact=contact), self.ctx(ud))
+        m = B.team(77)[0]
+        self.assertEqual((m["uid"], m["status"], m["car"], m["phone"]), (90, "pending", "damas", "+998901112233"))
+        self.assertTrue(any("тасдиқлайсизми" in s[2] for s in self.bot.to(77) if s[0] == "msg"))
+        await B.member_decide(upd(self.bot, 99, data="brm:ok:90"), self.ctx())  # бегона тасдиқлай олмайди
+        self.assertEqual(B.team(77)[0]["status"], "pending")
+        await B.member_decide(upd(self.bot, 77, data="brm:ok:90"), self.ctx())
+        self.assertEqual(B.team(77)[0]["status"], "ok")
+        self.assertTrue(any("auto:driver:pay" in str(s[3]) for s in self.bot.to(90)))   # тўлов тугмаси
+        await B.on_topup_approved(self.bot, 90, 50000)
+        self.assertEqual(B.owed(77), B.BRIGADA_SHARE)
+        await B.on_topup_approved(self.bot, 12345, 50000)                     # жамоасиз ҳайдовчи — улуш йўқ
+        self.assertEqual(B.owed(77), B.BRIGADA_SHARE)
+        await B.owner_buttons(upd(self.bot, OWNER, data="bro:paid:77"), self.ctx())
+        self.assertEqual(B.owed(77), 0)
+
+    async def test_contact_ignored_without_join(self):
+        contact = SimpleNamespace(user_id=91, phone_number="998901112299")
+        await B.join_contact(upd(self.bot, 91, contact=contact), self.ctx({}))
+        self.assertEqual(self.bot.sent, [])                                   # бошқа суҳбатларга халақит йўқ
+
+    async def test_not_admin_cannot_invite(self):
+        await B.owner_buttons(upd(self.bot, 42, data="bro:new"), self.ctx())
+        self.assertFalse(any(s[0] == "photo" for s in self.bot.sent))
+        await B.owner_panel(upd(self.bot, 42), self.ctx())
+        self.assertEqual(self.bot.sent, [])
+
+    async def test_owner_panel_and_bad_links(self):
+        await B.owner_panel(upd(self.bot, OWNER), self.ctx())
+        self.assertIn("БРИГАДИРЛАР", self.bot.to(OWNER)[-1][2])
+        self.assertTrue(await B.brigada_start(upd(self.bot, 50), self.ctx(), "bt999"))
+        self.assertFalse(await B.brigada_start(upd(self.bot, 50), self.ctx(), "reklama"))
+
+
+if __name__ == "__main__":
+    unittest.main()
