[Unit]
Description=PAPA XOTIRA — @XotiraMarkaziBot: бесплатные посты памяти → ХОТИРА КАНАЛИ ХЎЖАОБОД (с одобрением владельца)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=papa-xotira
Group=papa-xotira
EnvironmentFile=/etc/papa-xotira/xotira.env
Environment=XOTIRA_DB=/var/lib/papa-xotira/xotira.sqlite3 PYTHONUNBUFFERED=1
WorkingDirectory=/opt/papa/modules/xotira
# 19.10: с OpenCV (обрезка скриншотов) — из venv; если venv ещё нет — системный Python, бот работает без обрезки
ExecStart=/bin/sh -c 'P=/opt/papa-venv/xotira/bin/python; [ -x "$$P" ] || P=/usr/bin/python3; exec "$$P" -m xotira'
Restart=on-failure
RestartSec=30
StateDirectory=papa-xotira
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
UMask=0077
# 21.10: +узнавание лица (SFace int8, ~+50 МБ)
MemoryMax=220M
CPUQuota=30%
TasksMax=8

[Install]
WantedBy=multi-user.target
