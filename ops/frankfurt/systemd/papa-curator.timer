[Unit]
Description=PAPA куратор — лучшее из папок-источников → карточки в пульты (08:00, 12:30, 17:00 Ташкент)

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
OnCalendar=*-*-* 07:30:00 UTC
OnCalendar=*-*-* 12:00:00 UTC
RandomizedDelaySec=3min
Persistent=false
Unit=papa-razvedka@curate.service

[Install]
WantedBy=timers.target
