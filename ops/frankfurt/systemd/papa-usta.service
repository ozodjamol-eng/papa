[Unit]
Description=PAPA USTA — бот заявок «уй ва таъмир» (дизайн, таъмир, электрик, сантехник, мебель)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=papa-usta
Group=papa-usta
EnvironmentFile=/etc/papa-usta/bot.env
Environment=USTA_DB=/var/lib/papa-usta/usta.sqlite3 PYTHONUNBUFFERED=1
WorkingDirectory=/opt/papa/modules/usta
ExecStart=/usr/bin/python3 -m usta
Restart=on-failure
RestartSec=30
StateDirectory=papa-usta
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
UMask=0077
MemoryMax=80M
CPUQuota=20%
TasksMax=8

[Install]
WantedBy=multi-user.target
