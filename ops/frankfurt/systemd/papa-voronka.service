[Unit]
Description=PAPA Voronka — комментарии Instagram → директ; заявки Telegram → приветствие
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=papa-voronka
Group=papa-voronka
# пока бот — тестовый (PAPA TEST); боевой бот подключается отдельным шагом
EnvironmentFile=/etc/papa-test/bot.env
Environment=PAPA_VORONKA_DB=/var/lib/papa-voronka/voronka.sqlite3 PAPA_VORONKA_IG_ENV=/etc/papa-voronka/instagram.env PYTHONUNBUFFERED=1
WorkingDirectory=/opt/papa/modules/voronka
ExecStart=/usr/bin/python3 -m voronka loop
Restart=on-failure
RestartSec=30
StateDirectory=papa-voronka
StateDirectoryMode=0700
ReadWritePaths=/etc/papa-voronka
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
MemoryHigh=80M
MemoryMax=120M
CPUQuota=20%
TasksMax=16

[Install]
WantedBy=multi-user.target
